---
import '../styles/global.css'
import Hero from '../components/Hero.astro'
import { profile, type Section } from '../data/profile'

interface Props {
  title?: string
  intro?: string
  description?: string
  page?: Section
  article?: boolean
}

const {
  title = profile.name,
  intro = profile.intro,
  description = intro,
  page = 'home',
  article = false,
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page === 'home' ? title : title + ' · ' + profile.name}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#15191b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/PixelifySans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/Inter-Latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Hero title={title} intro={intro} page={page} article={article}>
      <slot name="scene-detail" />
    </Hero>
    <main class="reading-column" id="main-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

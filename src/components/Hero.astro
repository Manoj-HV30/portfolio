---
import { navigation, type Section } from '../data/profile'

interface Props {
  title: string
  intro: string
  page: Section
  article: boolean
}

const { title, intro, page, article } = Astro.props
const scenes = {
  home: { src: '/ruins.webp', width: 1536, height: 512 },
  projects: { src: '/core-machinery.webp', width: 1536, height: 512 },
  blog: { src: '/waterfall-violet.webp', width: 1536, height: 512 },
  vault: { src: '/vault-library-photo.webp', width: 2400, height: 800 },
  about: { src: '/night-horizon.webp', width: 1536, height: 512 },
}
const artwork = scenes[page]
const souls = {
  home: { color: 'determination', trait: 'Determination' },
  projects: { color: 'bravery', trait: 'Bravery' },
  blog: { color: 'integrity', trait: 'Integrity' },
  vault: { color: 'perseverance', trait: 'Perseverance' },
  about: { color: 'kindness', trait: 'Kindness' },
}
const soul = souls[page]
---

<header class:list={['masthead', page]} id="top" tabindex="-1">
  <picture class="masthead-art" aria-hidden="true">
    <img src={artwork.src} width={artwork.width} height={artwork.height} alt="" fetchpriority="high" />
  </picture>

  <div class="masthead-copy">
    <nav aria-label="Main navigation">
      {navigation.map(({ page: section, label, href }) => (
        <a href={href} aria-current={section === page ? (article ? 'location' : 'page') : undefined}>{label}</a>
      ))}
    </nav>
    <h1 class:list={{ 'home-title': page === 'home' }}>
      {page === 'home' && <img src="/papyrus-alternate.webp" alt="" width="100" height="100" />}
      {title}
    </h1>
    {intro && <p>{intro}</p>}
  </div>
  <span class:list={['soul-heart', soul.color]} role="img" aria-label={soul.trait}>
    <svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
      <path d="M3 1h3v1h2v2h2V2h2V1h3v1h1v1h1v4h-1v2h-2v2h-2v2h-2v1h-2v-1H6v-2H4v-2H2V9H1V5h1V3h1z" />
    </svg>
  </span>
  <slot />
</header>





<style>
  .soul-heart {
    position: absolute;
    right: clamp(1.1rem, 7vw, 7rem);
    bottom: 1.8rem;
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--soul-color);
  }

  .soul-heart svg {
    display: block;
    width: 2rem;
    height: 2rem;
    overflow: visible;
    fill: currentColor;
    filter: drop-shadow(0 2px 3px #080b12aa);
  }

  .determination { --soul-color: #ff4b54; }
  .bravery { --soul-color: #f29a48; }
  .integrity { --soul-color: #579bf1; }
  .perseverance { --soul-color: #bd82e8; }
  .kindness { --soul-color: #72cb79; }

  @media (prefers-reduced-motion: no-preference) {
    .soul-heart svg { animation: heart-beat 1.25s ease-in-out infinite; }
  }

  @keyframes heart-beat {
    0%, 100% { transform: scale(0.92); }
    14% { transform: scale(1.08); }
    28% { transform: scale(0.97); }
    42% { transform: scale(1.04); }
  }

  @media (max-width: 48rem) {
    .soul-heart { right: 1rem; bottom: 1.2rem; width: 2.9rem; height: 2.9rem; }
    .soul-heart svg { width: 1.9rem; height: 1.9rem; }
  }

  .masthead {
    --top-space: 6.5625rem;
    --title-gap: 3.9375rem;
    --title-size: clamp(3.28125rem, 8vw, 4.59375rem);
    --tagline-gap: 1.640625rem;
    --tagline-size: 1.18125rem;
    --nav-size: 1.18125rem;
    --art-focus: 60% 53%;
    --blend-depth: 7rem;
    position: relative;
    isolation: isolate;
    padding-block: var(--top-space) 5.9rem;
    background: var(--page);
    text-align: center;
  }

  .masthead:not(.home) {
    padding-bottom: 3.6rem;
  }

  .masthead.about {
    padding-bottom: 5.15rem;
    --art-focus: 57% 55%;
  }

  .masthead.home {
    --art-focus: 66% 62%;
    padding-bottom: 3.125rem;
  }
  .projects { --art-focus: 66% 53%; }
  .blog { --art-focus: 67% 63%; }
  .vault { --art-focus: 64% 55%; }

  .masthead-art, .masthead::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .masthead-art {
    z-index: -2;
    background: #161d29;
  }

  .masthead-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--art-focus);
  }

  .masthead::after {
    z-index: -1;
    content: '';
    background:
      linear-gradient(0deg, var(--page), transparent var(--blend-depth)),
      radial-gradient(ellipse at 50% 47%, #10141c91 0%, #10141c45 39%, transparent 72%),
      linear-gradient(180deg, #10141ca8, #10141c30 40%, transparent 62%);
  }

  .masthead-copy {
    width: min(calc(100% - 1.5rem), 52rem);
    margin-inline: auto;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem clamp(0.65rem, 3.35vw, 1.95rem);
    font-size: var(--nav-size);
    font-weight: 600;
    line-height: 1.7;
  }

  nav a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-shadow: 0 1px 8px #10141c;
  }

  nav a:is([aria-current], :hover, :focus-visible) {
    color: var(--link);
    text-decoration-color: currentColor;
  }

  h1 {
    margin: var(--title-gap) 0 0;
    color: var(--ink);
    font: 400 var(--title-size)/1.1 var(--display);
    letter-spacing: -0.04em;
    text-wrap: balance;
    text-shadow: 0 2px 0 #151923, 0 3px 18px #11151f;
  }

  p {
    margin: var(--tagline-gap) auto 0;
    color: var(--ink);
    font-size: var(--tagline-size);
    line-height: 1.7;
    text-shadow: 0 1px 8px #10141c;
  }

  .home-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.55rem, 1.5vw, 1rem);
  }

  .home-title img {
    width: clamp(4rem, 10vw, 7rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    flex: none;
    border-radius: 0.45rem;

  }

  @media (max-width: 48rem) {
    .masthead {
      --top-space: 3.9375rem;
      --title-gap: 1.96875rem;
      --tagline-gap: 0.984375rem;
      --nav-size: 1.115625rem;
      --blend-depth: 5rem;
      padding-bottom: 4rem;
    }

    .masthead:not(.home) { padding-bottom: 2.65rem; }
    .masthead.about { padding-bottom: 4rem; }
    .masthead.home {
      --art-focus: 66% 62%;
      padding-bottom: 1.55rem;
    }

    .masthead.home .soul-heart {
      position: absolute;
      top: calc(var(--top-space) + 4rem);
      right: 1rem;
      bottom: auto;
      margin: 0;
    }
  }

  @media (max-width: 30rem) {
    .masthead {
      --top-space: 3.1875rem;
      --title-gap: 1.59375rem;
      --title-size: clamp(2.65625rem, 8vw, 3.71875rem);
      --tagline-gap: 0.796875rem;
      --tagline-size: 0.95625rem;
      --nav-size: 0.903125rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .masthead-art { animation: settle-art 420ms ease-out; }
    h1 { animation: settle-title 420ms ease-out; }
  }

  @keyframes settle-art {
    from { opacity: 0.86; }
  }

  @keyframes settle-title {
    from { opacity: 0.84; translate: 0 5px; }
  }
</style>

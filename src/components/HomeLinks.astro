---
const socials = [
  { id: 'email', label: 'Email Manoj', href: 'mailto:hello@manojhv.tech' },
  { id: 'x', label: 'X — papyrus_IRL', href: 'https://x.com/papyrus_IRL' },
  { id: 'discord', label: 'Discord — papyrus_irl', href: 'https://discord.com/users/1248511302054445202' },
  { id: 'telegram', label: 'Telegram — pappyyrus', href: 'https://t.me/pappyyrus' },
]
---

<div class="home-links" role="group" aria-label="Profile and contact links">
  <div class="text-links">
    <a href="https://github.com/Manoj-HV30">GitHub</a>
    <span aria-hidden="true">|</span>
    <a href="/resume.pdf">Résumé</a>
  </div>
  <div class="icon-links">
    {socials.map(({ id, label, href }) => (
      <a href={href} class="icon-link" aria-label={label} title={label}>
        {id === 'email' ? (
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m4 7 8 6 8-6" />
          </svg>
        ) : <span aria-hidden="true" class:list={['social-icon', id]} />}
      </a>
    ))}
  </div>
</div>

<style>
  .home-links,
  .text-links,
  .icon-links {
    display: flex;
    align-items: center;
  }

  .home-links {
    flex-wrap: wrap;
    gap: 0 0.85rem;

    font-size: 0.9375rem;
  }

  .text-links {
    gap: 0.65rem;
    font: 400 clamp(1.55rem, 5vw, 2rem)/1 var(--display);
  }

  .text-links a,
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
  }

  .icon-link {
    text-decoration: none;
  }

  .social-icon {
    width: 1.0625rem;
    height: 1.0625rem;
    background: currentColor;
    mask: var(--icon) center / contain no-repeat;
  }

  .x { --icon: url('/icons/x.svg'); }
  .discord { --icon: url('/icons/discord.svg'); }
  .telegram { --icon: url('/icons/telegram.svg'); }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro'
import HomeLinks from '../components/HomeLinks.astro'
---

<BaseLayout>
  <HomeLinks />
  <a class="music-note" href="https://www.last.fm/user/DrunkButSober" data-music-note>
    <svg class="disc" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="11.5" fill="#292322" />
      <circle cx="12" cy="12" r="9.4" fill="none" stroke="#504440" />
      <circle cx="12" cy="12" r="7.6" fill="none" stroke="#504440" />
      <path d="M3.3 13a8.8 8.8 0 0 1 5.5-9M20.7 11a8.8 8.8 0 0 1-5.5 9" fill="none" stroke="#a89179" stroke-linecap="round" />
      <circle cx="12" cy="12" r="4.6" fill="#a6533e" />
      <path d="M12 7.4a4.6 4.6 0 0 1 4.6 4.6H12z" fill="#d58d67" />
      <circle cx="12" cy="12" r="1" fill="#f0ddba" />
    </svg>
    <span class="track">See recent tracks on Last.fm</span>
  </a>
</BaseLayout>

<script>
  const note = document.querySelector<HTMLAnchorElement>('[data-music-note]')
  const label = note?.querySelector('.track')
  const feed = 'https://lastfm-last-played.biancarosa.com.br/DrunkButSober/latest-song'

  async function refreshTrack() {
    if (!note || !label || document.hidden) return

    try {
      const response = await fetch(feed, { cache: 'no-store', signal: AbortSignal.timeout(8000) })
      if (!response.ok) throw new Error('Last.fm feed unavailable')
      const { track } = await response.json()
      if (typeof track?.name !== 'string' || typeof track.artist?.['#text'] !== 'string') {
        throw new Error('Incomplete track data')
      }

      const playing = track['@attr']?.nowplaying === 'true' || track['@attr']?.nowplaying === true
      const description = `${playing ? 'Now playing' : 'Last played'} · ${track.name} · ${track.artist['#text']}`
      label.textContent = description
      note.title = description
      note.toggleAttribute('data-playing', playing)
    } catch {
      label.textContent = 'See recent tracks on Last.fm'
      note.removeAttribute('title')
      note.removeAttribute('data-playing')
    }
  }

  refreshTrack()
  window.setInterval(refreshTrack, 20000)
  document.addEventListener('visibilitychange', refreshTrack)
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) refreshTrack()
  })
</script>

<style>
  .music-note {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 100%;
    margin: 1.3rem 0 2rem;
    padding: 0.18rem 0.85rem 0.3rem;
    background: repeating-linear-gradient(0deg, #a3885c25 0 1px, transparent 1px 21px), #efdfbb;
    color: #382a24;
    box-shadow: 2px 3px 0 #090e1166;
    font: 650 clamp(1.15rem, 4vw, 1.6rem)/1.2 Caveat, cursive;
    text-decoration: none;
    white-space: nowrap;
  }

  .music-note:hover {
    color: #382a24;
    text-decoration: underline;
  }

  .disc {
    flex: 0 0 1.05em;
    width: 1.05em;
    height: 1.05em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .music-note[data-playing] .disc {
      animation: spin-disc 5s linear infinite;
    }
  }

  @keyframes spin-disc {
    to { transform: rotate(1turn); }
  }

  .track {
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
